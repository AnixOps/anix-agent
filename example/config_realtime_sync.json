{
  "Log": {
    "Level": "info",
    "Output": ""
  },
  "Cores": [
    {
      "Type": "sing",
      "Log": {
        "Level": "info",
        "Timestamp": true
      },
      "NTP": {
        "Enable": false,
        "Server": "time.apple.com",
        "ServerPort": 0
      },
      "OriginalPath": "/etc/anixops/agent/sing_origin.json"
    }
  ],
  "Nodes": [
    {
      "Core": "sing",
      "ApiHost": "https://your-panel.com",
      "Transport": "http",
      "GRPCHost": "your-panel.com:443",
      "GRPCUseTLS": true,
      "GRPCServerName": "your-panel.com",
      "AgentControlEnabled": true,
      "AgentControlAllowInsecure": false,
      "PluginSupervisorEnabled": true,
      "PluginRoot": "/var/lib/anixops-agent/plugins",
      "PluginSocketDir": "/run/anixops-agent/plugins",
      "PluginOfficialPublicKey": "IaqXgif/OGydNv/mQHoyFmqOvzeplICaMZndrhqMG0M=",
      
      // 鑷姩娉ㄥ唽閰嶇疆
      "AutoRegister": true,
      "AuthKey": "your-auth-key-from-panel",
      "NodeName": "Tokyo-Node-01",
      "NodeHost": "",
      "NodePort": 443,
      "CredentialFile": "data/credential.json",
      "HeartbeatInterval": 60,
      
      // 瀹夊叏閰嶇疆
      "EnableSign": true,
      "EncryptCredential": true,
      
      // 瀹炴椂鍚屾閰嶇疆 (鍙岃竟閫氳)
      "SyncConfig": {
        // 鏄惁鍚敤 WebSocket 瀹炴椂鍚屾
        "EnableWebSocket": true,
        // WebSocket 绔偣璺緞
        "WSEndpoint": "/api/v2/agent/ws",
        // 鍏煎鏃ч潰鏉挎椂鍙嚜鍔ㄥ洖閫€
        "WSEndpointFallbacks": ["/api/v2/node/ws"],
        // 鏂嚎閲嶈繛闂撮殧 (绉?
        "ReconnectInterval": 5,
        // 鏈€澶ч噸杩炲皾璇曟鏁?(0=鏃犻檺)
        "MaxReconnectTries": 0,
        // 蹇冭烦闂撮殧 (绉?
        "PingInterval": 30,
        // Pong 瓒呮椂鏃堕棿 (绉?
        "PongTimeout": 10,
        // 娑堟伅纭瓒呮椂 (绉?
        "AckTimeout": 5,
        // ACK 瓒呮椂鍚庨噸璇曟鏁?
        "AckRetries": 2,
        // 娑堟伅缂撳啿鍖哄ぇ灏?
        "BufferSize": 100,
        // 鏄惁鍚敤闄嶇骇妯″紡 (WebSocket 涓嶅彲鐢ㄦ椂鑷姩鍒囨崲鍒拌疆璇?
        "EnableFallback": true,
        // 闄嶇骇妯″紡杞闂撮殧 (绉?
        "FallbackInterval": 60
      },
      
      "Timeout": 30,
      "ListenIP": "0.0.0.0",
      "SendIP": "0.0.0.0",
      "DeviceOnlineMinTraffic": 200,
      "MinReportTraffic": 0,
      "TCPFastOpen": false,
      "SniffEnabled": true,
      "CertConfig": {
        "CertMode": "self",
        "RejectUnknownSni": false,
        "CertDomain": "example.com",
        "CertFile": "/etc/anixops/agent/fullchain.cer",
        "KeyFile": "/etc/anixops/agent/cert.key",
        "Provider": "cloudflare",
        "DNSEnv": {
          "EnvName": "env1"
        }
      }
    }
  ]
}
